# JobTread Pave API grant key (create in JT: settings -> API / integrations).
JT_GRANT_KEY=

# Signs the app's session tokens (Google sign-in). Generate one:
# openssl rand -hex 32
SESSION_SECRET=

# Google OAuth web client id (public), from Google Cloud Console ->
# Credentials -> OAuth client ID (Web application).
GOOGLE_CLIENT_ID=

# Accounts allowed to sign in: this Workspace domain...
GOOGLE_WORKSPACE_DOMAIN=deitemeyerbrothers.com
# ...plus any extra addresses, comma-separated (e.g. an owner's personal account).
GOOGLE_ALLOWED_EMAILS=

# Validates the JobTread webhook URL path. Generate: openssl rand -hex 24
WEBHOOK_SECRET=

# Gemini API key (aistudio.google.com/app/apikey) for Spanish translation of
# JobTread text in the app. Optional — English is shown until set.
GEMINI_API_KEY=

# Optional overrides
PORT=8787
